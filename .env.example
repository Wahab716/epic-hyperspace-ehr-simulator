# Local practice works without an environment file.
# WORKSPACE_AUTH_MODE=local
# WORKSPACE_DATA_DIR=.data
# Optional: provide a stable, random session signing secret instead of .data/session-secret.
# WORKSPACE_SESSION_SECRET=replace-with-a-long-random-secret

# Optional authenticated reverse-proxy hosting (configure the proxy separately):
# WORKSPACE_AUTH_MODE=trusted-proxy
# WORKSPACE_PROXY_SECRET=replace-with-a-long-random-secret
